# Leave OPENAI_API_KEY empty to run fully offline with the deterministic planner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# duckdb | postgres
WAREHOUSE=duckdb
DUCKDB_PATH=./data/warehouse.duckdb
POSTGRES_DSN=postgresql://analyst_ro:analyst_ro@localhost:5432/warehouse

# Auth: off by default. If AUTH_ENABLED=true, API_KEYS must be set or startup fails.
AUTH_ENABLED=false
API_KEYS=
# e.g. API_KEYS="k-admin-0123456789abcdef:admin:alice,k-view-0123456789abcd:viewer:dash"

# Audit log (separate SQLite db; never the analytical warehouse)
AUDIT_ENABLED=true
AUDIT_DB_PATH=./data/audit.sqlite

MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=20
MAX_JOINS=4
RETRIEVAL_TOP_K=6

API_URL=http://localhost:8000

# UI only: key the Streamlit app presents to the API when auth is on.
API_KEY=
