# --- LLM ---
# Three modes:
#   1. Nothing set        -> deterministic planner, no network. Works fully.
#   2. OPENAI_API_KEY     -> hosted OpenAI.
#   3. LLM_BASE_URL       -> any OpenAI-compatible LOCAL server; nothing leaves the host.
#                            Ollama    http://localhost:11434/v1
#                            vLLM      http://localhost:8000/v1
#                            LM Studio http://localhost:1234/v1
# LLM_BASE_URL takes precedence over OPENAI_API_KEY, so a stray key cannot
# cause prompts to be sent off-host once a local endpoint is configured.
LLM_PROVIDER=auto
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# duckdb | postgres
WAREHOUSE=duckdb
DUCKDB_PATH=./data/warehouse.duckdb
POSTGRES_DSN=postgresql://analyst_ro:analyst_ro@localhost:5432/warehouse

# Auth: off by default. If AUTH_ENABLED=true, API_KEYS must be set or startup fails.
AUTH_ENABLED=false
API_KEYS=
# e.g. API_KEYS="k-admin-0123456789abcdef:admin:alice,k-view-0123456789abcd:viewer:dash"

# Audit log (separate SQLite db; never the analytical warehouse)
AUDIT_ENABLED=true
AUDIT_DB_PATH=./data/audit.sqlite

MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=20
MAX_JOINS=4
RETRIEVAL_TOP_K=6

API_URL=http://localhost:8000

# UI only: key the Streamlit app presents to the API when auth is on.
API_KEY=
