# Leave OPENAI_API_KEY empty to run fully offline with the deterministic planner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# duckdb | postgres
WAREHOUSE=duckdb
DUCKDB_PATH=./data/warehouse.duckdb
POSTGRES_DSN=postgresql://analyst_ro:analyst_ro@localhost:5432/warehouse

MAX_ROWS=1000
QUERY_TIMEOUT_SECONDS=20
MAX_JOINS=4
RETRIEVAL_TOP_K=6

API_URL=http://localhost:8000
